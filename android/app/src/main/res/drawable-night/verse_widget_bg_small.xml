<?xml version="1.0" encoding="utf-8"?>
<!--
  Small (2x2) widget background — dark theme. Mirrors the design's
  `linear-gradient(160deg,#1B2145 0%,#0C1026 100%)`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF1B2145"
        android:endColor="#FF0C1026" />
</shape>
